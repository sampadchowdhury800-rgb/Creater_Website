# =============================================================================
# .env.example — Environment variable template for Chowdhury Duo
#
# RULES:
#   - Copy this file to .env and fill in real values
#   - NEVER commit .env to source control
#   - Variables marked [SERVER ONLY] must never use NEXT_PUBLIC_ prefix
#   - Variables marked [OPTIONAL] are not required for basic operation
# =============================================================================


# =============================================================================
# Database — Neon PostgreSQL (main application database)
# =============================================================================
DATABASE_URL=your_neon_postgresql_connection_string_here


# =============================================================================
# Cloudinary (image/file uploads)
# =============================================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here


# =============================================================================
# Session Security [SERVER ONLY]
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# =============================================================================
SESSION_SECRET=your_128_hex_character_session_secret_here


# =============================================================================
# Admin Account (used ONLY by scripts/seed-admin.ts)
# =============================================================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisToAStrongPassword123!


# =============================================================================
# Razorpay (payment gateway) [SERVER ONLY]
# Get from: https://dashboard.razorpay.com -> Settings -> API Keys
# =============================================================================
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here


# =============================================================================
# Site URL (used for SEO and absolute URL generation)
# =============================================================================
NEXT_PUBLIC_SITE_URL=https://chowdhuryduo.in


# =============================================================================
# Clerk (customer authentication)
# Get from: https://dashboard.clerk.com -> API Keys
# CLERK_SECRET_KEY must stay server-side — never use NEXT_PUBLIC_ prefix
# =============================================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here


# =============================================================================
# Automation Credential Vault [SERVER ONLY]
# Encrypts sensitive user credentials stored in UserAutomationSecret table.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: Changing this after production setup makes existing secrets unrecoverable.
# =============================================================================
AUTOMATION_VAULT_KEY=your_64_hex_character_vault_key_here


# =============================================================================
# =============================================================================
# AI Support Assistant [SERVER ONLY]
# Used by the Gmail AI Support backend for email classification and reply generation.
# Primary provider is OpenRouter (OpenAI-compatible).
# You may also supply GEMINI_API_KEY or OPENAI_API_KEY directly.
# Get OpenRouter key: https://openrouter.ai/settings/keys
#
# AI_SUPPORT_FREE_ONLY:
#   true  = only free-tier models are allowed (recommended)
#   false = paid models allowed (not recommended — watch your spending)
#
# AI_SUPPORT_MODEL:
#   openrouter/free              = OpenRouter auto-selects best free model
#   meta-llama/llama-3.1-8b-instruct:free
#   mistralai/mistral-7b-instruct:free
#   google/gemma-3-12b-it:free
# =============================================================================
AI_SUPPORT_API_KEY=your_openrouter_api_key_here
AI_SUPPORT_MODEL=openrouter/free
AI_SUPPORT_BASE_URL=https://openrouter.ai/api/v1
AI_SUPPORT_FREE_ONLY=true
# Optional direct provider API keys (supported as fallbacks by ai-service):
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# NOTE ON VECTOR DATABASE (PINECONE):
# External Pinecone vector DB (PINECONE_API_KEY, PINECONE_INDEX) is NOT used.
# The project uses native PostgreSQL pgvector and full-text search (search_knowledge_text)
# inside Supabase and Neon databases. No external vector service is required.


# =============================================================================
# Support Email (Brevo REST API) [SERVER ONLY]
# Used by lib/email/brevo.ts to send support escalations.
# Get API key: https://app.brevo.com/settings/keys/api
# =============================================================================
BREVO_API_KEY=your_brevo_api_key_here
SUPPORT_EMAIL=chowdhuryduo@gmail.com
SUPPORT_FROM_EMAIL=chowdhuryduo@gmail.com


# =============================================================================
# Supabase Project — Gmail AI Support Backend
# The NEW Supabase project is the dedicated backend for Gmail automation.
# Get these from: https://supabase.com/dashboard/project/<ref>/settings/api
#
# SUPABASE_URL              = Project URL (server-side)
# SUPABASE_ANON_KEY         = anon public key (client-safe)
# SUPABASE_SERVICE_ROLE_KEY = service_role key — SERVER ONLY (NEVER expose to browser)
# NEXT_PUBLIC_SUPABASE_URL  = Browser-safe Project URL
# NEXT_PUBLIC_SUPABASE_ANON_KEY = Browser-safe anon key
# =============================================================================
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here


# =============================================================================
# Gmail App Passwords — LOCAL DEVELOPMENT ONLY [SERVER ONLY]
# NOT required in production SaaS. In production, each customer Gmail account
# is connected via POST /api/integrations/gmail/connect (see GMAIL_AI_SUPPORT_SETUP.md).
# Credentials are encrypted per-tenant in Supabase gmail_accounts table.
# These vars below are only used for quick local testing of a single account.
# =============================================================================
# GMAIL_EMAIL=yourbusiness@gmail.com
# GMAIL_APP_PASSWORD=abcdefghijklmnop


# =============================================================================
# Internal Service Authentication [SERVER ONLY]
# Single shared secret for ALL internal service-to-service calls:
#   - Supabase pg_cron → Vercel Gmail polling endpoint (x-cron-secret header)
#   - n8n orchestrator → Vercel internal gateway (x-internal-service-key header)
# ONE secret. Do NOT configure a separate CRON_SECRET.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the same value in:
#   (a) Vercel Project Environment Variables as CHOWDHURY_DUO_GATEWAY_SECRET
#   (b) The x-cron-secret header value in your Supabase pg_cron SQL job
# =============================================================================
CHOWDHURY_DUO_GATEWAY_SECRET=your_64_hex_character_internal_secret_here


# =============================================================================
# Slack Notifications [SERVER ONLY] [OPTIONAL]
# Per-business Slack webhooks are configured in the business_rules table.
# These are only used as a global fallback for development testing.
# =============================================================================
SLACK_DEFAULT_WEBHOOK_URL=your_slack_webhook_url_here
SLACK_DEFAULT_CHANNEL_ID=your_slack_channel_id_here


# =============================================================================
# DEPRECATED — n8n (replaced by Supabase Gmail AI Support backend)
# Kept for reference only. Not used by any active code path.
# =============================================================================
N8N_BASE_URL=
N8N_API_KEY=

