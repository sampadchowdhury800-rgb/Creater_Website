# =============================================================
# Neon PostgreSQL Database
# =============================================================
DATABASE_URL="postgresql://YOUR_NEON_CONNECTION_STRING"

# =============================================================
# Cloudinary
# =============================================================
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# =============================================================
# Session Security
# Generate using:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# =============================================================
SESSION_SECRET=""

# =============================================================
# Initial Administrator Account
# Used ONLY by scripts/seed-admin.ts
# =============================================================
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeThisToAStrongPassword123!"


# =============================================================
# Razorpay (Payment Gateway)
# Get these from Razorpay Dashboard -> Settings -> API Keys
# =============================================================
RAZORPAY_KEY_ID="rzp_test_..."
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# =============================================================
# Canonical Site URL (SEO / AEO / GEO)
# MUST match your production domain exactly (no trailing slash).
# Set this in Vercel Dashboard → Project → Settings → Environment Variables.
# =============================================================
NEXT_PUBLIC_SITE_URL="https://chowdhuryduo.vercel.app"

# =============================================================
# Clerk (Customer Authentication)
# Get these from: https://dashboard.clerk.com -> API Keys
# Put these in .env.local (NOT .env) — never commit .env.local
# CLERK_SECRET_KEY must NEVER be exposed to client-side code
# =============================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# =============================================================
# n8n Automation Execution Engine (server-side only)
# DO NOT use NEXT_PUBLIC_ prefix for these variables.
# =============================================================
N8N_BASE_URL=""
N8N_API_KEY=""

# =============================================================
# Automation Credential Vault Encryption Key (server-side only)
# Used to encrypt sensitive user credentials (API keys, tokens, passwords)
# stored in the UserAutomationSecret table.
#
# CRITICAL SECURITY RULES:
#   - NEVER use NEXT_PUBLIC_ prefix for this variable.
#   - NEVER commit this key to source control.
#   - NEVER store this value in the database.
#   - Once set in production, changing this key will make all existing
#     encrypted secrets unrecoverable. Plan key rotation carefully.
#   - In development, if not set, the vault uses an insecure fallback key
#     and logs a warning. Production always requires a real key.
#
# Generate a secure key:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Format: 64 hex characters (32 bytes) — recommended
# =============================================================
AUTOMATION_VAULT_KEY=""

# =============================================================
# AI Support Assistant (Server-Side Only)
# Used by lib/ai-support/ to provide product & marketplace support.
#
# CRITICAL SECURITY RULES:
#   - NEVER use NEXT_PUBLIC_ prefix for these variables.
#   - AI_SUPPORT_API_KEY must stay server-side only.
#   - Get your OpenRouter API key at: https://openrouter.ai/settings/keys
#
# AI_SUPPORT_FREE_ONLY:
#   When "true" (the default), the provider refuses to call any model that is
#   not on the known-free allowlist. Only "openrouter/free" and any model
#   ID that ends in ":free" are accepted.
#   Setting this to "false" allows paid model IDs but is NOT recommended.
#
# AI_SUPPORT_MODEL:
#   Defaults to "openrouter/free" — OpenRouter's free-routing alias that
#   selects the best available free-tier model automatically.
#   You may also pin a specific free model using a ":free"-suffixed ID:
#     meta-llama/llama-3.1-8b-instruct:free
#     mistralai/mistral-7b-instruct:free
#     google/gemma-3-12b-it:free
# =============================================================
AI_SUPPORT_API_KEY=""
AI_SUPPORT_MODEL="openrouter/free"
AI_SUPPORT_BASE_URL="https://openrouter.ai/api/v1"
AI_SUPPORT_FREE_ONLY="true"

# =============================================================
# Developer Support Escalation Email (Brevo REST API)
# Used by lib/email/brevo.ts to send support escalations to the developer.
#
# CRITICAL SECURITY RULES:
#   - NEVER use NEXT_PUBLIC_ prefix for these variables.
#   - BREVO_API_KEY must stay server-side only. NEVER commit it.
#
# Get your API key from: https://app.brevo.com/settings/keys/api
# Endpoint used: https://api.brevo.com/v3/smtp/email
# =============================================================
BREVO_API_KEY="your_brevo_api_key"
SUPPORT_EMAIL="chowdhuryduo@gmail.com"
SUPPORT_FROM_EMAIL="chowdhuryduo@gmail.com"

