# =============================================================
# Neon PostgreSQL Database
# =============================================================
DATABASE_URL="postgresql://YOUR_NEON_CONNECTION_STRING"

# =============================================================
# Cloudinary
# =============================================================
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# =============================================================
# Session Security
# Generate using:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# =============================================================
SESSION_SECRET=""

# =============================================================
# Initial Administrator Account
# Used ONLY by scripts/seed-admin.ts
# =============================================================
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeThisToAStrongPassword123!"


# =============================================================
# Razorpay (Payment Gateway)
# Get these from Razorpay Dashboard -> Settings -> API Keys
# =============================================================
RAZORPAY_KEY_ID="rzp_test_..."
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# =============================================================
# Canonical Site URL (SEO / AEO / GEO)
# MUST match your production domain exactly (no trailing slash).
# Set this in Vercel Dashboard → Project → Settings → Environment Variables.
# =============================================================
NEXT_PUBLIC_SITE_URL="https://chowdhuryduo.vercel.app"

# =============================================================
# Clerk (Customer Authentication)
# Get these from: https://dashboard.clerk.com -> API Keys
# Put these in .env.local (NOT .env) — never commit .env.local
# CLERK_SECRET_KEY must NEVER be exposed to client-side code
# =============================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
